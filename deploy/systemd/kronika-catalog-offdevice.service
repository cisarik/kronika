[Unit]
Description=Kronika off-device catalog backup copy and restore verification
Documentation=https://github.com/cisarik/kronika
After=local-fs.target
RequiresMountsFor=/var/lib/kronika /mnt/framenest-catalog-offdevice

[Service]
Type=oneshot
User=kronika
Group=kronika
WorkingDirectory=/opt/kronika/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/kronika/kronika.env
ExecStart=/opt/kronika/current/.venv/bin/kronika-backup run-offdevice
Nice=10
TimeoutStartSec=30min
KillMode=mixed
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
StateDirectory=kronika
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectHostname=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadOnlyPaths=/var/lib/kronika/catalog-backups
ReadWritePaths=/var/lib/kronika/catalog-backup-ops /var/lib/kronika/catalog-restore-verify /mnt/framenest-catalog-offdevice/bundles
InaccessiblePaths=/srv/media

[Install]
WantedBy=multi-user.target
