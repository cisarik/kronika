[Unit]
Description=Kronika capture browser runner
Documentation=https://github.com/cisarik/kronika
After=kronika-capture-xvfb.service kronika-capture-bridge.service
Requires=kronika-capture-xvfb.service

[Service]
Type=simple
User=kronika-capture
Group=kronika-capture
WorkingDirectory=/opt/kronika/capture-current
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:99
Environment=XAUTHORITY=/run/kronika-capture/Xauthority
Environment=TMPDIR=/run/kronika-capture/tmp
EnvironmentFile=/etc/kronika-capture/capture.env
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/kronika-capture/profile /var/lib/kronika-capture/staging /run/kronika-capture/tmp
ExecStart=/opt/kronika/capture-current/.venv/bin/kronika-capture --state-dir /var/lib/kronika-capture runner run --profile /var/lib/kronika-capture/profile --port 8765 --headed
Restart=no
LoadCredential=token:/etc/kronika-capture/credentials/kronika-bridge-token
StateDirectory=kronika-capture
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/kronika-capture /run/kronika-capture /tmp/.X11-unix
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
