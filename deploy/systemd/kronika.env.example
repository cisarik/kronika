# Kronika systemd non-secret environment template.
# Copy to /etc/kronika/kronika.env and edit for the target host.
# Do not put API keys, tokens, passwords, cookies, or private keys in this file.

KRONIKA_HOST=127.0.0.1
KRONIKA_PORT=8000
KRONIKA_DATABASE_PATH=/var/lib/kronika/catalog.sqlite3
KRONIKA_GALLERY_PREVIEW_CACHE_PATH=/var/cache/kronika/gallery-previews
KRONIKA_COVER_STORAGE_ROOT=/var/lib/kronika/covers
KRONIKA_COVER_THUMBNAIL_CACHE_PATH=/var/cache/kronika/cover-thumbnails
KRONIKA_AI_CONFIG_PATH=/var/lib/kronika/ai/config.json

# Automated catalog backup (ADR-0052). Catalog-only; does not back up original media.
KRONIKA_CATALOG_BACKUP_ROOT=/var/lib/kronika/catalog-backups
KRONIKA_CATALOG_RESTORE_VERIFY_ROOT=/var/lib/kronika/catalog-restore-verify
KRONIKA_CATALOG_BACKUP_OPS_ROOT=/var/lib/kronika/catalog-backup-ops
KRONIKA_CATALOG_BACKUP_KEEP_AUTO=30

# Optional off-device catalog copy (ADR-0056). Non-secret destination identity pin.
# The scheduled destination mount is fixed at /mnt/framenest-catalog-offdevice
# and is a named frozen residue: the account and product identity change does
# not rename it. This value must match the root-owned destination marker
# destination_id (32 lowercase hex). Leave unset to keep off-device copy
# disabled.
# KRONIKA_CATALOG_OFFDEVICE_DESTINATION_ID=

# Optional YouTube manual ingestion. This pre-existing private directory must
# remain disjoint from quarantine, cache, database, and registered media roots.
# Enabling it also requires the existing upload quarantine and publication
# destination configuration.
# KRONIKA_YOUTUBE_ACQUISITION_ROOT=/var/lib/kronika/youtube-acquisition
# KRONIKA_YOUTUBE_ACQUISITION_MAX_STAGING_BYTES=2214592512

# Optional non-secret server AI selection. Provider credentials belong in the
# service-secret integration documented as deferred in
# docs/UBUNTU_NUC_DEPLOYMENT.md.
# KRONIKA_AI_PROVIDER_ID=vercel-ai-gateway
# KRONIKA_AI_MODEL_ID=google/gemini-3.1-flash-lite

# Optional automatic post-catalog analysis. Disabled by default in git.
# An administrator may later enable it from companion Settings without rewriting
# this file; that overlay is `{database_path.parent}/runtime-settings.json`
# (typically /var/lib/kronika/runtime-settings.json) and is not catalog-backed-up.
# KRONIKA_AUTOMATIC_MEDIA_ANALYSIS_ENABLED=false
# Bound provider invocation attempts for one automatic analysis run (1-10).
# KRONIKA_AUTOMATIC_MEDIA_ANALYSIS_MAX_ATTEMPTS=1

# Optional Tailscale remote-access ingress. When enabled, the application
# stops listening on TCP and binds only this permission-restricted Unix
# socket; the only remote ingress is root-owned Tailscale HTTPS Serve.
# All four keys are required together, the origin must be the exact
# https origin of the tailnet node (no path, no trailing slash), and the
# identity map must name at least one exact login with the "admin" role.
# KRONIKA_INGRESS_MODE=tailscale_uds
# KRONIKA_UDS_PATH=/run/kronika/kronika.sock
# KRONIKA_EXTERNAL_ORIGIN=https://<node>.<tailnet>.ts.net
# KRONIKA_IDENTITY_MAP={"<login>@<example>":"<admin|user>"}

# Optional unpacked Chromium companion origin allowlist. Empty by default;
# mutations stay fail-closed until an exact chrome-extension:// id is listed.
# Flagged only for POST /api/x/requests and POST /api/x/requests/{id}/retry.
# KRONIKA_COMPANION_EXTENSION_ORIGINS=["chrome-extension://<32-char-id>"]
