[Unit]
Description=Kronika local-first media library server
Documentation=https://github.com/cisarik/kronika
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kronika
Group=kronika
WorkingDirectory=/opt/kronika/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/kronika/kronika.env
ExecStartPre=/opt/kronika/current/.venv/bin/kronika-production check-database-ready
ExecStart=/opt/kronika/current/.venv/bin/kronika-production serve
KillSignal=SIGTERM
TimeoutStopSec=30s
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
StateDirectory=kronika
StateDirectoryMode=0700
CacheDirectory=kronika
RuntimeDirectory=kronika
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
