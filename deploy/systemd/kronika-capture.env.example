# Kronika capture non-secret environment template.
# Copy to /etc/kronika-capture/capture.env for the target host.
# Do not put API keys, tokens, passwords, cookies, or private keys in this file.
# The per-install bridge token is a systemd credential named "token".
# Its root-owned source is /etc/kronika-capture/credentials/kronika-bridge-token.
# Units load that credential with LoadCredential=. This file never carries it.

# The runner launcher reads only this value. It must be an absolute executable
# verified by host preflight. The launcher does not search PATH and does not
# weaken the browser sandbox.
KRONIKA_CHROMIUM_PATH=/usr/bin/chromium

# Contract paths and ports. The capture units and the release helper hardcode
# the same values. Editing this file alone does not move them. A port that is
# already bound must stop setup; nothing here selects a public or random port.
# KRONIKA_CAPTURE_ACCOUNT=kronika-capture
# KRONIKA_CAPTURE_STATE_DIR=/var/lib/kronika-capture
# KRONIKA_CAPTURE_PROFILE=/var/lib/kronika-capture/profile
# KRONIKA_CAPTURE_JOURNAL=/var/lib/kronika-capture/capture-journal.sqlite3
# KRONIKA_CAPTURE_STAGING=/var/lib/kronika-capture/staging
# KRONIKA_CAPTURE_RUNTIME_DIR=/run/kronika-capture
# KRONIKA_CAPTURE_RELEASE=/opt/kronika/capture-current
# KRONIKA_CAPTURE_DISPLAY=:99
# KRONIKA_CAPTURE_BRIDGE_HOST=127.0.0.1
# KRONIKA_CAPTURE_BRIDGE_PORT=8765
# KRONIKA_CAPTURE_VNC_PORT=5900
# KRONIKA_CAPTURE_NOVNC_PORT=6080
# XAUTHORITY=/run/kronika-capture/Xauthority
