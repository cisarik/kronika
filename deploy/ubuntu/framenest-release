#!/usr/bin/env fish

# Retained entry-point spelling. The canonical release entry point is
# deploy/ubuntu/kronika-release (ADR-0085); this file forwards every argument
# and the exit status to that same engine and is kept until the compatibility
# spellings are removed.

set -l script_dir (dirname (status filename))
set -l entry "$script_dir/kronika-release"

if not test -x "$entry"
    echo "Kronika release engine is unavailable." >&2
    exit 1
end

exec "$entry" $argv