#!/usr/bin/env fish

# Canonical routine immutable NUC release-update entry point (ADR-0085).
# deploy/ubuntu/framenest-release is a retained compatibility wrapper for this
# same engine and forwards identical arguments.

set -l script_dir (dirname (status filename))
set -l engine "$script_dir/kronika_release.py"

if not test -f "$engine"
    echo "Kronika release engine is unavailable." >&2
    exit 1
end

set -l repo_root (git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)
if test $status -ne 0
    echo "Kronika repository root could not be resolved." >&2
    exit 1
end

set -l python "$repo_root/.venv/bin/python"
if not test -x "$python"
    echo "Kronika repository .venv Python is unavailable." >&2
    exit 1
end

# Every engine subcommand is forwarded unchanged, including capture activation.
command "$python" "$engine" $argv
exit $status