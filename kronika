#!/usr/bin/env fish

set -g script_dir (dirname (status filename))
set -g repo_root (realpath "$script_dir")
set -g controller "$repo_root/.venv/bin/kronika-dev"
set -g ai_controller "$repo_root/.venv/bin/kronika-ai"
set -g backup_controller "$repo_root/.venv/bin/kronika-backup"
set -g recovery_controller "$repo_root/.venv/bin/kronika-recovery"
set -g library_python "$repo_root/.venv/bin/python"
set -g youtube_controller "$repo_root/.venv/bin/kronika-youtube"
set -g local_ai_env "$repo_root/.secrets/ai.env.fish"
set -g local_dotenv "$repo_root/.env"
set -gx POETRY_VIRTUALENVS_IN_PROJECT true

function _kronika_help
    echo "Kronika local development launcher"
    echo ""
    echo "Usage:"
    echo "  ./kronika setup"
    echo "  ./kronika start [--no-open]"
    echo "  ./kronika stop"
    echo "  ./kronika restart [--no-open]"
    echo "  ./kronika status"
    echo "  ./kronika open"
    echo "  ./kronika logs [--follow]"
    echo "  ./kronika ai status"
    echo "  ./kronika ai configure"
    echo "  ./kronika ai test"
    echo "  ./kronika backup create"
    echo "  ./kronika backup verify"
    echo "  ./kronika backup restore"
    echo "  ./kronika backup run-scheduled"
    echo "  ./kronika backup status"
    echo "  ./kronika backup list"
    echo "  ./kronika backup retain-plan"
    echo "  ./kronika backup expire"
    echo "  ./kronika backup verify-restore"
    echo "  ./kronika backup export-latest"
    echo "  ./kronika recovery init-store"
    echo "  ./kronika recovery pull"
    echo "  ./kronika recovery list"
    echo "  ./kronika recovery verify"
    echo "  ./kronika library status"
    echo "  ./kronika library add"
    echo "  ./kronika library refresh"
    echo "  ./kronika youtube ingest URL"
    echo "  ./kronika youtube status CLAIM_ID"
    echo "  ./kronika youtube retry CLAIM_ID"
    echo "  ./kronika previews status"
    echo "  ./kronika previews generate"
    echo "  ./kronika --help"
    echo "  ./kronika <command> --help"
end

function _kronika_setup
    if not command -q uv
        echo "Kronika setup requires uv." >&2
        return 127
    end
    if not command -q poetry
        echo "Kronika setup requires Poetry." >&2
        return 127
    end

    set -l python_path
    set python_path (command uv python find 3.13.14 2>/dev/null)
    if test $status -ne 0
        echo "Installing CPython 3.13.14 with uv..."
        command uv python install 3.13.14
        or return $status
        set python_path (command uv python find 3.13.14)
        or return $status
    end

    cd "$repo_root"
    or return $status
    command poetry env use "$python_path"
    or return $status
    command poetry install --no-interaction
    or return $status

    if not test -x "$controller"
        echo "Kronika setup failed: development controller is unavailable." >&2
        return 1
    end

    echo "Kronika setup complete."
end

function _kronika_load_local_ai_env
    if not test -e "$local_ai_env"
        return 0
    end
    if test -L "$local_ai_env"
        echo "Kronika local AI secrets file is unsafe." >&2
        return 1
    end
    if not test -f "$local_ai_env"
        echo "Kronika local AI secrets file is unsafe." >&2
        return 1
    end

    set -l current_uid (id -u)
    set -l stat_output
    set -l stat_fields
    set stat_output (command stat -f "%u %Lp" "$local_ai_env" 2>/dev/null)
    if test $status -ne 0
        set stat_output (command stat -c "%u %a" "$local_ai_env" 2>/dev/null)
        if test $status -ne 0
            echo "Kronika local AI secrets file metadata is unavailable." >&2
            return 1
        end
    end
    set stat_fields (string split " " -- $stat_output)
    if test (count $stat_fields) -ne 2
        echo "Kronika local AI secrets file metadata is unavailable." >&2
        return 1
    end
    if test "$stat_fields[1]" != "$current_uid"
        echo "Kronika local AI secrets file is unsafe." >&2
        return 1
    end
    set -l group_other_permissions (math "$stat_fields[2] % 100")
    if test "$group_other_permissions" -ne 0
        echo "Kronika local AI secrets file is unsafe." >&2
        return 1
    end
    command fish --no-execute "$local_ai_env" >/dev/null 2>/dev/null
    if test $status -ne 0
        echo "Kronika local AI secrets file is invalid." >&2
        return 1
    end
    source "$local_ai_env" >/dev/null 2>/dev/null
    if test $status -ne 0
        echo "Kronika local AI secrets file could not be loaded." >&2
        return 1
    end
    return 0
end

function _kronika_use_repo_env_file
    # Development convenience: expose the repository-root .env only as an
    # explicit, deterministic configuration file. An operator-supplied
    # FRAMENEST_ENV_FILE always wins and is never overridden here.
    if set -q FRAMENEST_ENV_FILE
        return 0
    end
    if not test -e "$local_dotenv"
        return 0
    end
    if test -L "$local_dotenv"
        echo "Kronika repository .env file is unsafe." >&2
        return 1
    end
    if not test -f "$local_dotenv"
        echo "Kronika repository .env file is unsafe." >&2
        return 1
    end
    set -gx FRAMENEST_ENV_FILE "$local_dotenv"
    return 0
end

if test (count $argv) -eq 0
    _kronika_help
    exit 0
end

switch "$argv[1]"
    case --help -h
        _kronika_help
        exit 0
    case setup
        _kronika_setup
        exit $status
    case start stop restart status open logs
        if not test -x "$controller"
            _kronika_setup
            or exit $status
        end
        if contains -- "$argv[1]" start restart
            _kronika_load_local_ai_env
            or exit $status
        end
        "$controller" $argv
        exit $status
    case ai
        if not test -x "$ai_controller"
            _kronika_setup
            or exit $status
        end
        _kronika_load_local_ai_env
        or exit $status
        _kronika_use_repo_env_file
        or exit $status
        "$ai_controller" $argv[2..-1]
        exit $status
    case backup
        if not test -x "$backup_controller"
            _kronika_setup
            or exit $status
        end
        _kronika_use_repo_env_file
        or exit $status
        "$backup_controller" $argv[2..-1]
        exit $status
    case recovery
        if not test -x "$recovery_controller"
            _kronika_setup
            or exit $status
        end
        _kronika_use_repo_env_file
        or exit $status
        "$recovery_controller" $argv[2..-1]
        exit $status
    case library
        if not test -x "$library_python"
            _kronika_setup
            or exit $status
        end
        cd "$repo_root"
        or exit $status
        _kronika_use_repo_env_file
        or exit $status
        "$library_python" -m kronika.adapters.cli.library $argv[2..-1]
        exit $status
    case previews
        if not test -x "$library_python"
            _kronika_setup
            or exit $status
        end
        cd "$repo_root"
        or exit $status
        _kronika_use_repo_env_file
        or exit $status
        "$library_python" -m kronika.adapters.cli.previews $argv[2..-1]
        exit $status
    case youtube
        if not test -x "$youtube_controller"
            _kronika_setup
            or exit $status
        end
        _kronika_use_repo_env_file
        or exit $status
        "$youtube_controller" $argv[2..-1]
        exit $status
    case '*'
        echo "Unknown Kronika command: $argv[1]" >&2
        _kronika_help >&2
        exit 2
end
