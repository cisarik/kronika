#!/usr/bin/env fish

# Retired launcher spelling. The canonical root launcher is ./kronika (ADR-0085);
# this file is a thin pass-through wrapper kept until the compatibility
# spellings are removed. It forwards every argument and the exit status.

set -g script_dir (dirname (status filename))
set -g repo_root (realpath "$script_dir")

if not test -x "$repo_root/kronika"
    echo "Kronika launcher is unavailable at $repo_root/kronika." >&2
    exit 127
end

exec "$repo_root/kronika" $argv
